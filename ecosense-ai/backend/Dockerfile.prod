# ===========================================
# EcoSense AI — Backend Dockerfile (PROD)
# ===========================================

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# -------------------------------------------
# System dependencies
# -------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    python3-gdal \
    libpq-dev \
    gcc \
    g++ \
    python3-dev \
    libgeos-dev \
    libproj-dev \
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------
# GDAL / GEOS config
# -------------------------------------------
ENV GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
ENV GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# -------------------------------------------
# App setup
# -------------------------------------------
WORKDIR /app

COPY requirements.txt .

RUN pip install --upgrade pip && \
    pip install --no-cache-dir --use-feature=fast-deps -r requirements.txt

COPY . .

# -------------------------------------------
# Collect static
# -------------------------------------------
RUN python manage.py collectstatic --noinput || true

EXPOSE 8000

# Sync workers with threads (NOT gevent): report generation runs in a real
# background OS thread inside the view. Under gevent, monkey.patch_all() turns
# that thread into a cooperative greenlet — CPU-bound WeasyPrint/ML work never
# yields, blocks the event loop, and the master SIGKILLs the "hung" worker,
# leaving reports stuck in 'generating' forever. Sync workers avoid that:
#   --workers 1   keep peak memory low on a small instance
#   --threads 4   serve status polling concurrently with the generation thread
#   --timeout 120 only bounds in-request time; the 202 returns immediately, so
#                 the idle worker keeps heartbeating while generation continues
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "4", "--timeout", "120"]
