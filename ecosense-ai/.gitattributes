# Normalize line endings so the repo stops showing every file as "modified"
# when edited across Windows/Linux tooling. Text files are stored as LF in git.
* text=auto eol=lf

# Explicitly treat common source/text types as text (LF in the repo).
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.sol   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf

# Windows batch files should keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pkl   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
